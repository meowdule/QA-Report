        "pageErrorCount"
      ]
    },
    "primary_flow": {
      "labelKo": "주요 흐름",
      "description": "핵심 URL 순서로 이동·표시가 완료되는지",
      "primarySteps": [
        "navigate",
        "assertVisible",
        "waitForResponse"
      ],
      "metrics": [
        "stepSequenceComplete",
        "chainLength"
